"""
Runs eris on every assembly in the sample sheet and scores its IS–CDS relations against the curated truth.

    snakemake --cores 4                                  # everything, into `outdir` from config/config.yaml
    snakemake --cores 4 --config outdir=results          # somewhere else
"""
import pandas as pd


configfile: "config/config.yaml"


SAMPLES = pd.read_csv(config["samples"], sep="\t", dtype=str).fillna("")
SAMPLES = SAMPLES.set_index(["genome", "assembly_type"], drop=False)
if SAMPLES.index.duplicated().any():
    raise ValueError("samples.tsv: each (genome, assembly_type) must appear once")
OUT = config.get("outdir", "results")
COMMIT = config["eris"]["commit"]
ERIS_DIR = f"resources/eris/{COMMIT}"


def sample(wildcards):
    return SAMPLES.loc[(wildcards.genome, wildcards.assembly_type)]


include: "rules/eris.smk"
include: "rules/score.smk"


rule all:
    input:
        f"{OUT}/metrics.tsv",
        f"{OUT}/details.tsv",
